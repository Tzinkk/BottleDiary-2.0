rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(data) {
      return data.userId == request.auth.uid;
    }

    // --- Entity Validation ---
    function isValidWineBottle(data) {
      let requiredFields = ['id', 'name', 'producer', 'type', 'dateAdded', 'userId', 'year', 'region', 'country', 'grape', 'tastingNotes'];
      return data.keys().hasAll(requiredFields)
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.producer is string && data.producer.size() > 0 && data.producer.size() <= 200
        && data.year is string && data.year.size() > 0 && data.year.size() <= 10
        && data.type is string && data.type.size() > 0 && data.type.size() <= 50
        && data.region is string && data.region.size() <= 200
        && data.country is string && data.country.size() <= 100
        && (!('grape' in data) || (data.grape is list && data.grape.size() <= 20))
        && (!('foodPairing' in data) || (data.foodPairing is list && data.foodPairing.size() <= 20))
        && data.tastingNotes is string && data.tastingNotes.size() <= 2000
        && data.dateAdded is number
        && data.userId == request.auth.uid;
    }

    function isValidGrapeVariety(data) {
      let requiredFields = ['id', 'name', 'type', 'userId', 'dateAdded'];
      return data.keys().hasAll(requiredFields)
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.type is string && (data.type == 'Red' || data.type == 'White')
        && (!('locations' in data) || (data.locations is list && data.locations.size() <= 40))
        && (!('foodPairing' in data) || (data.foodPairing is list && data.foodPairing.size() <= 20))
        && data.userId == request.auth.uid;
    }

    // --- Collections ---
    match /bottles/{bottleId} {
      allow get: if isSignedIn() && isOwner(existing());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(bottleId)
        && isValidWineBottle(incoming())
        && incoming().id == bottleId;

      allow update: if isSignedIn()
        && isValidId(bottleId)
        && isValidWineBottle(incoming())
        && isOwner(existing())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().dateAdded == existing().dateAdded;

      allow delete: if isSignedIn() 
        && isValidId(bottleId)
        && isOwner(existing());
    }

    match /grapes/{grapeId} {
      allow get: if isSignedIn() && isOwner(existing());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(grapeId)
        && isValidGrapeVariety(incoming())
        && incoming().id == grapeId;

      allow update: if isSignedIn()
        && isValidId(grapeId)
        && isValidGrapeVariety(incoming())
        && isOwner(existing())
        && incoming().id == existing().id
        && incoming().userId == existing().userId;

      allow delete: if isSignedIn() 
        && isValidId(grapeId)
        && isOwner(existing());
    }

    // Test entry for connection validation
    match /test/connection {
      allow get: if true;
    }
  }
}
