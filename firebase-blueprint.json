{
  "entities": {
    "WineBottle": {
      "title": "WineBottle",
      "description": "A bottle of wine in the user's cellar.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "producer": { "type": "string" },
        "year": { "type": "string" },
        "type": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string" },
        "grape": { "type": "array", "items": { "type": "string" } },
        "tastingNotes": { "type": "string" },
        "additionalNote": { "type": "string" },
        "locationPurchased": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "foodPairing": { "type": "array", "items": { "type": "string" } },
        "dateAdded": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "producer", "type", "dateAdded", "userId"]
    },
    "GrapeVariety": {
      "title": "GrapeVariety",
      "description": "A database of grape varieties and their characteristics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["Red", "White"] },
        "skin": { "type": "string" },
        "locations": { "type": "array", "items": { "type": "string" } },
        "body": { "type": "string" },
        "acidity": { "type": "string" },
        "tannin": { "type": "string" },
        "sweetness": { "type": "string" },
        "aromaFlavor": { "type": "string" },
        "otherNotes": { "type": "string" },
        "foodPairing": { "type": "array", "items": { "type": "string" } },
        "additionalNotes": { "type": "string" },
        "userId": { "type": "string" },
        "dateAdded": { "type": "number" }
      },
      "required": ["id", "name", "type", "userId", "dateAdded"]
    }
  },
  "firestore": {
    "bottles/{bottleId}": {
      "schema": "WineBottle",
      "description": "User's wine collection."
    },
    "grapes/{grapeId}": {
      "schema": "GrapeVariety",
      "description": "User's grape encyclopedia."
    }
  }
}
